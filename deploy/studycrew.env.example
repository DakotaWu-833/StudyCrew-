# Copy to /etc/studycrew/studycrew.env and replace every CHANGE_ME value.
# Keep this file root-owned (root:studycrew, mode 0640).
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY='CHANGE_ME_RANDOM_50_PLUS_CHARACTERS'
DJANGO_ALLOWED_HOSTS='CHANGE_ME_DOMAIN'
DJANGO_CSRF_TRUSTED_ORIGINS='https://CHANGE_ME_DOMAIN'

DB_ENGINE=postgresql
DB_NAME=studycrew
DB_USER=studycrew_app
DB_PASSWORD='CHANGE_ME_RUNTIME_DATABASE_PASSWORD'
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST='CHANGE_ME_SMTP_HOST'
EMAIL_PORT=587
EMAIL_HOST_USER='CHANGE_ME_SMTP_USERNAME'
EMAIL_HOST_PASSWORD='CHANGE_ME_SMTP_PASSWORD'
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL='StudyCrew <CHANGE_ME_SENDER>'

SESSION_IDLE_TIMEOUT_SECONDS=1800
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
EXTERNAL_API_TIMEOUT_SECONDS=3
NAGER_DATE_CACHE_TTL_SECONDS=86400
TRUSTED_PROXY_COUNT=1
USE_X_ACCEL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# Private project uploads require ClamAV with an updated signature database.
PROJECT_FILES_REQUIRE_SCAN=true
PROJECT_FILES_CLAMSCAN=/usr/bin/clamscan
PROJECT_FILE_MAX_BYTES=10485760
PROJECT_FILE_QUOTA_BYTES=262144000
PROJECT_FILE_DAILY_BYTES=104857600
PROJECT_FILE_DAILY_UPLOADS=30
