# Protected /etc/studycrew/backup-offhost.env (root:studycrew, 0640).
# This is read by systemd, never sourced or evaluated by the script.
BACKUP_OFFHOST_PYTHON=/srv/studycrew/venv/bin/python
BACKUP_ROOT=/srv/studycrew/app/var/backups
BACKUP_OFFHOST_SPOOL=/srv/studycrew/app/var/offhost
BACKUP_OFFHOST_MAX_AGE_HOURS=30
# Omit BACKUP_SOURCE to select the newest completed manifest in BACKUP_ROOT.
# BACKUP_SOURCE=/srv/studycrew/app/var/backups/REVIEWED_SNAPSHOT
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_RECIPIENT
BACKUP_OFFHOST_REMOTE=CHANGE_ME_REMOTE:studycrew-backups
BACKUP_RCLONE_CONFIG=/etc/studycrew/rclone.conf
