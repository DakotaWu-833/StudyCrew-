# Merge into /etc/studycrew/studycrew.env; retain production database/SMTP/TLS/scanning.
# Cloud chat and tools use only the separately approved provider's credential.
RAG_PROVIDER=compatible
RAG_BASE_URL=https://api.groq.com/openai/v1
RAG_MODEL=openai/gpt-oss-20b
RAG_API_KEY='CHANGE_ME_PRIVATE_PROVIDER_KEY'
RAG_TIMEOUT_SECONDS=20
RAG_AGENT_TIMEOUT_SECONDS=24
RAG_RETRIEVAL_MODE=hybrid

# Keep Ollama bound to loopback and install only the embedding model on this host.
# An explicitly separate embedding endpoint never inherits RAG_API_KEY.
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_API_KEY=''
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Set the actual deployed /api/tags model digest before accepting cached vectors.
RAG_EMBEDDING_REVISION=CHANGE_ME_DEPLOYED_MODEL_SHA256
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=4
