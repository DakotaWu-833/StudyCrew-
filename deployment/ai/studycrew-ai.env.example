# Add these AI settings to the protected existing production environment.
# Retain all Django/TLS/SMTP/PostgreSQL/scanner settings from the reviewed deployment.
RAG_PROVIDER=ollama
RAG_BASE_URL=http://127.0.0.1:11434
RAG_MODEL=qwen3.5:9b-q4_K_M
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Verify against the deployed /api/tags digest; update this after changing model weights.
RAG_EMBEDDING_REVISION=ac6da0dfba84a81fdbfbaf330198c33cd77c4cdfc53e8bc50eb581914a15621d
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=16
RAG_RETRIEVAL_MODE=hybrid
RAG_DISABLE_THINKING=true
RAG_NUM_CTX=8192
RAG_MAX_OUTPUT_TOKENS=1200
RAG_KEEP_ALIVE=10m
RAG_TIMEOUT_SECONDS=20
RAG_AGENT_TIMEOUT_SECONDS=24
RAG_API_KEY=''
