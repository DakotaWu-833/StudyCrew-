[Unit]
Description=StudyCrew encrypted off-host backup transport
After=network-online.target studycrew-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=studycrew
Group=www-data
WorkingDirectory=/srv/studycrew/app
EnvironmentFile=/etc/studycrew/backup-offhost.env
ExecStart=/usr/bin/bash /srv/studycrew/app/deployment/scripts/backup-offhost.sh
TimeoutStartSec=3600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/studycrew/app/var/offhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
