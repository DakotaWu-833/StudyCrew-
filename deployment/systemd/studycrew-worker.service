[Unit]
Description=StudyCrew durable delivery and export worker
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=studycrew
Group=www-data
WorkingDirectory=/srv/studycrew/app
EnvironmentFile=/etc/studycrew/studycrew.env
ExecStart=/srv/studycrew/venv/bin/python /srv/studycrew/app/manage.py run_delivery_worker --interval 30 --limit 50
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/studycrew/app/var
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
