# Ubuntu/systemd example. Keep real secrets outside the repository.
# Use a protected /etc/studycrew/studycrew.env (root:studycrew, mode 0640).
DJANGO_ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY='CHANGE_ME_RANDOM_50_PLUS_CHARACTERS'
DJANGO_ALLOWED_HOSTS='CHANGE_ME_DOMAIN'
DJANGO_CSRF_TRUSTED_ORIGINS='https://CHANGE_ME_DOMAIN'
PUBLIC_BASE_URL='https://CHANGE_ME_DOMAIN'
DB_ENGINE=postgresql
DB_NAME=studycrew
DB_USER=studycrew_app
DB_PASSWORD='CHANGE_ME_RUNTIME_PASSWORD'
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
MEDIA_PATH=/srv/studycrew/app/var/media
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST='CHANGE_ME_SMTP_HOST'
EMAIL_PORT=587
EMAIL_HOST_USER='CHANGE_ME_SMTP_USER'
EMAIL_HOST_PASSWORD='CHANGE_ME_SMTP_PASSWORD'
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL='StudyCrew <CHANGE_ME_VERIFIED_SENDER>'
MAIL_MESSAGE_DOMAIN='CHANGE_ME_DOMAIN'
MAIL_DAILY_LIMIT=2000
MAIL_RETENTION_DAYS=30
MAIL_WEBHOOK_SECRET='CHANGE_ME_RANDOM_WEBHOOK_SECRET'
SERVICE_CONTACT_EMAIL='CHANGE_ME_SUPPORT_EMAIL'
ASYNC_EXPORTS=true
ASYNC_REMINDERS=true
OPERATIONS_RATE_LIMITS=true
MAINTENANCE_MODE=false
TRUSTED_PROXY_COUNT=1
USE_X_ACCEL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

BACKUP_ROOT=/srv/studycrew/app/var/backups
BACKUP_MAX_AGE_HOURS=30

# Install ClamAV and keep its signature database updated. No unscanned production uploads.
PROJECT_FILES_REQUIRE_SCAN=true
PROJECT_FILES_CLAMSCAN=/usr/bin/clamscan
PROJECT_FILE_MAX_BYTES=10485760
PROJECT_FILE_QUOTA_BYTES=262144000
PROJECT_FILE_DAILY_BYTES=104857600
PROJECT_FILE_DAILY_UPLOADS=30
