# Local defaults. Never commit a real production secret or database password.
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Use sqlite for the zero-configuration local path or postgresql for parity.
DB_ENGINE=sqlite
SQLITE_PATH=var/studycrew.sqlite3
# DB_NAME=studycrew
# DB_USER=studycrew_app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=var/emails
DEFAULT_FROM_EMAIL=StudyCrew <noreply@studycrew.local>

SESSION_IDLE_TIMEOUT_SECONDS=1800
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
EXTERNAL_API_TIMEOUT_SECONDS=3
NAGER_DATE_CACHE_TTL_SECONDS=86400

# Production reverse-proxy integration (leave false for local runserver).
USE_X_ACCEL_REDIRECT=false
PROJECT_FILE_MAX_BYTES=10485760
PROJECT_FILE_QUOTA_BYTES=262144000
PROJECT_FILE_DAILY_BYTES=104857600
PROJECT_FILE_DAILY_UPLOADS=30
PROJECT_FILES_REQUIRE_SCAN=false
PROJECT_FILES_CLAMSCAN=
TRUSTED_PROXY_COUNT=0

# Advance launch workflows. The local launcher enables both asynchronous paths.
PUBLIC_BASE_URL=http://127.0.0.1:8000
MEDIA_PATH=var/media
ASYNC_EXPORTS=true
ASYNC_REMINDERS=true
OPERATIONS_RATE_LIMITS=true
MAINTENANCE_MODE=false
EMAIL_TIMEOUT=10
MAIL_DAILY_LIMIT=2000
MAIL_RETENTION_DAYS=30
MAIL_WEBHOOK_SECRET=
BACKUP_ROOT=var/backups
BACKUP_MAX_AGE_HOURS=30
